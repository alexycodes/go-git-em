# The cron command backs up at once, then whenever the schedule is due, until
# a signal stops it. Only the backup at startup can reach the @every 24h output
# in the time this takes. Only the test binary accepts @every.
exec git init -q src
exec git -C src commit -q --allow-empty -m one
exec gge cron --config cfg.yaml &
waitsnapshots startup 1 30s
waitsnapshots out 1 30s
exec git -C src commit -q --allow-empty -m two
waitsnapshots out 2 30s
sigterm
wait
stderr 'level=INFO msg=scheduled output='${WORKRE}${SEP}'out input='${WORKRE}${SEP}'src schedule="@every 1s" next='
stderr 'level=INFO msg=backup output='${WORKRE}${SEP}'out .* result=created snapshot='
stderr 'level=INFO msg=stopping$'
stderr 'level=INFO msg=stopped$'
! stderr 'level=ERROR'
refs-equal src out latest

-- cfg.yaml --
repositories:
  - input: ./src
    output: ./startup
    schedule: "@every 24h"
  - input: ./src
    output: ./out
    schedule: "@every 1s"
