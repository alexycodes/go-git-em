# A second go-git-em on an output that one is backing up skips it, and leaves
# the first one's work in progress alone.
expandenv cfg.yaml
exec gge -config cfg.yaml &
waitfor servers.log 30s 'hang: GET /hang/repo.git/'
exits 1 gge -once -config cfg.yaml
stderr 'level=WARN msg=backup output='${WORKRE}${SEP}'out .* result=skipped reason="another go-git-em is backing up this output"'
stderr 'level=ERROR msg="some outputs were locked by another go-git-em" locked=1 repositories=1'
exists out/mirror.git.tmp
sigterm
wait
stderr 'level=INFO msg=stopped$'

-- cfg.yaml --
repositories:
  - input: $GITHTTP/hang/repo.git
    output: out
    schedule: "@daily"
    timeout: 1m
