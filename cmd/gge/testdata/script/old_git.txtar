# A git older than the minimum stops go-git-em at startup with exit code 2.
[windows] skip 'the fake git is an sh script'
chmod 755 old/git
env PATH=$CMDBIN${:}$WORK/old
exits 2 gge backup --input ./src --output ./out
stderr 'level=ERROR msg="go-git-em needs a newer git" version=2\.28\.0 minimum=2\.29$'
! stderr 'msg=backup'
! exists out

exits 2 gge validate --input ./src --output ./out
stderr 'go-git-em needs a newer git'
! stdout .

-- old/git --
#!/bin/sh
echo 'git version 2.28.0'
