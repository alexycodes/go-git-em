# Without a config file, --input and --output describe one repository. Built-in
# defaults fill in the rest (no retention: every snapshot is kept), and paths
# resolve against the current directory.
exits 0 gge validate --input ./src --output out
! stdout '^config:'
stdout '^  - input: '${WORKRE}${SEP}'src$'
stdout '^    output: '${WORKRE}${SEP}'out$'
stdout '^    retention: 0$'
stdout '^    timeout: 30m0s$'
! stdout 'schedule:'
! stdout 'ssh_key:'

# A URL stays as written.
exits 0 gge validate --input https://example.invalid/a.git --output out
stdout '^  - input: https://example\.invalid/a\.git$'

# The cron command needs --schedule. --retention and --ssh-key apply as well.
exits 2 gge cron --input ./src --output out
stderr 'problem="--input repository \(\./src\): no schedule'
chmod 600 key
exits 0 gge validate --input ./src --output out --schedule '0 * * * *' --retention 3 --ssh-key key
stdout '^    schedule: 0 \* \* \* \*$'
stdout '^    retention: 3$'
stdout '^    ssh_key: '${WORKRE}${SEP}'key$'

# --input and --output go together, and --schedule and --retention need --input.
exits 2 gge validate --input ./src
stderr '^--input needs --output$'
exits 2 gge validate --output out
stderr '^--output needs --input'
exits 2 gge validate --schedule '0 0 * * *' --retention 3
stderr '^--schedule needs --input'
stderr '^--retention needs --input'

# With neither a config file nor --input, there's nothing to back up. The
# message says how to give repositories.
exits 2 gge validate
stderr 'problem="no repositories to back up: list them in a config file, go-git-em\.yaml in the current directory or one given with --config, or give one with --input and --output"'

# A real backup from flags alone.
exec git init -q src
exec git -C src commit -q --allow-empty -m one
exits 0 gge backup --input ./src --output out
snapshots out 1
refs-equal src out latest

-- key --
not a real key
