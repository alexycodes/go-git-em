# A config with problems fails with exit code 2 and one message per problem,
# all of them at once, before any Git work.
chmod 644 open_key
exits 2 gge validate --config problems.yaml
# Windows has no key permissions to check.
[!windows] stderr -count=8 'level=ERROR msg="invalid config" problem='
[windows] stderr -count=7 'level=ERROR msg="invalid config" problem='
stderr 'problem="defaults: schedule \\"0 3 \* \*\\": expected exactly 5 fields, found 4'
stderr 'problem="repository 1 \(\./src\): output is required"'
stderr 'problem="repository 2 \(https://example\.invalid/b\.git\): retention must be 0 or more, got -1"'
stderr 'problem="repository 3 \(https://example\.invalid/c\.git\): output '${WORKRE}${SEP}'out is already used by repository 2 \(https://example\.invalid/b\.git\)"'
stderr 'problem="repository 4 \(-oProxyCommand=evil\): input starts with \\"-\\", which git would read as an option"'
stderr 'problem="repository 5 \(git@example\.invalid:e\.git\): ssh_key '${WORKRE}${SEP}'missing_key doesn.t exist"'
[!windows] stderr 'problem="repository 6 \(git@example\.invalid:f\.git\): ssh_key '${WORKRE}${SEP}'open_key has permissions 0644, and OpenSSH refuses a private key that other users can access: run chmod 600 '${WORKRE}${SEP}'open_key"'
stderr 'problem="repository 7 \(https://example\.invalid/g\.git\): timeout must be more than 0, got 0s"'
! stderr 'found git'
! stdout .

# A backup stops the same way, and creates nothing.
exits 2 gge backup --config problems.yaml
[!windows] stderr -count=8 'msg="invalid config"'
[windows] stderr -count=7 'msg="invalid config"'
! exists out

# So does the cron command.
exits 2 gge cron --config problems.yaml
stderr 'expected exactly 5 fields, found 4'

# The cron command needs a schedule for every repository. gge validate only
# warns, and the backup command runs without.
exits 2 gge cron --config no_schedule.yaml
stderr 'problem="repository 1 \(https://example\.invalid/a\.git\): no schedule: the cron command needs one, on the repository or in defaults \(the backup command runs without\)"'
exits 0 gge validate --config no_schedule.yaml
stderr 'level=WARN msg="no schedule: the cron command needs one"'

# chmod 600 makes the key acceptable.
chmod 600 open_key
exits 0 gge validate --config key.yaml
stdout '^    ssh_key: '${WORKRE}${SEP}'open_key$'

# A typo in a key is an error, with its line, instead of a silent default.
exits 2 gge validate --config typo.yaml
stderr 'problem="typo\.yaml: line 4: unknown key \\"retension\\""'

# YAML that doesn't parse.
exits 2 gge validate --config broken.yaml
stderr 'problem="broken\.yaml: line 2: found character that cannot start any token"'

# Schedules that aren't standard cron, although robfig/cron accepts them, or
# that it would crash on or never run. (@every is checked in internal/schedule:
# the test binary accepts it.)
exits 2 gge validate --config bad_schedules.yaml
stderr -count=5 'msg="invalid config"'
stderr 'repository 1 \(https://example\.invalid/a\.git\): schedule \\"CRON_TZ=Europe/Paris 0 3 \* \* \*\\": a time zone prefix isn.t supported: schedules follow the process.s time zone'
stderr 'repository 2 \(https://example\.invalid/b\.git\): schedule \\"@daily\\": shortcuts aren.t supported: write \\"0 0 \* \* \*\\"'
stderr 'repository 3 \(https://example\.invalid/c\.git\): schedule \\"0 3 \? \* \*\\": \\"\?\\" isn.t supported: use \\"\*\\"'
stderr 'repository 4 \(https://example\.invalid/d\.git\): schedule \\"CRON_TZ=UTC\\": a time zone prefix isn.t supported'
stderr 'repository 5 \(https://example\.invalid/e\.git\): schedule \\"0 0 30 2 \*\\": matches no date in the next 5 years'
! stderr panic

# A config file that doesn't exist.
exits 2 gge validate --config nope.yaml
stderr 'msg="can.t read the config file" err="open '${WORKRE}${SEP}'nope\.yaml: (no such file or directory|The system cannot find the file specified\.)"'

-- problems.yaml --
defaults:
  schedule: "0 3 * *"
repositories:
  - input: ./src
  - input: https://example.invalid/b.git
    output: ./out
    retention: -1
  - input: https://example.invalid/c.git
    output: out/
  - input: -oProxyCommand=evil
    output: ./d
  - input: git@example.invalid:e.git
    output: ./e
    ssh_key: missing_key
  - input: git@example.invalid:f.git
    output: ./f
    ssh_key: open_key
  - input: https://example.invalid/g.git
    output: ./g
    timeout: 0s
-- no_schedule.yaml --
repositories:
  - input: https://example.invalid/a.git
    output: a
  - input: https://example.invalid/b.git
    output: b
    schedule: "0 0 * * *"
-- key.yaml --
repositories:
  - input: git@example.invalid:f.git
    output: f
    ssh_key: open_key
-- typo.yaml --
repositories:
  - input: https://example.invalid/a.git
    output: a
    retension: 3
-- bad_schedules.yaml --
repositories:
  - input: https://example.invalid/a.git
    output: a
    schedule: CRON_TZ=Europe/Paris 0 3 * * *
  - input: https://example.invalid/b.git
    output: b
    schedule: "@daily"
  - input: https://example.invalid/c.git
    output: c
    schedule: "0 3 ? * *"
  - input: https://example.invalid/d.git
    output: d
    schedule: CRON_TZ=UTC
  - input: https://example.invalid/e.git
    output: e
    schedule: "0 0 30 2 *"
-- broken.yaml --
defaults:
  schedule: @daily
-- open_key --
not a real key
