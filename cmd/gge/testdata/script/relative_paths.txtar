# Relative paths in a config file resolve against the file's directory, so the
# config works the same from any directory. ~/ expands to $HOME.
chmod 600 conf/key
mkdir elsewhere
cd elsewhere
exits 0 gge check-config --config ../conf/cfg.yaml
stdout '^config: '${WORKRE}${SEP}'conf'${SEP}'cfg\.yaml$'
stdout '^  - input: '${WORKRE}${SEP}'conf'${SEP}'src$'
stdout '^    output: '${WORKRE}${SEP}'conf'${SEP}'out$'
stdout '^  - input: git@example\.invalid:x\.git$'
stdout '^    output: '${HOMERE}${SEP}'backups'${SEP}'x$'
stdout -count=2 '^    ssh_key: '${WORKRE}${SEP}'conf'${SEP}'key$'

# Paths from flags resolve against the current directory.
exits 0 gge check-config --config ../conf/cfg.yaml --input ../conf/src --output out
stdout '^    output: '${WORKRE}${SEP}'elsewhere'${SEP}'out$'

# A real backup, still from elsewhere, lands next to the config file.
exec git init -q ../conf/src
exec git -C ../conf/src commit -q --allow-empty -m one
exits 0 gge backup --config ../conf/local.yaml
snapshots ../conf/out 1
refs-equal ../conf/src ../conf/out latest
! exists out

-- conf/local.yaml --
repositories:
  - input: ./src
    output: out
-- conf/cfg.yaml --
defaults:
  ssh_key: key
repositories:
  - input: ./src
    output: out
  - input: git@example.invalid:x.git
    output: ~/backups/x
-- conf/key --
not a real key
