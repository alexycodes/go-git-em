# Without a command, or with an unknown one, go-git-em lists its commands and
# exits 2.
exits 2 gge
stderr '^Usage of go-git-em: <command> \[flags\]$'
stderr '^  backup '
stderr '^  cron '
stderr '^  check '
stderr '^  validate '
stderr '^  version '
! stdout .
exits 2 gge restore
stderr '^unknown command "restore"$'
stderr '^  backup '
exits 2 gge --config cfg.yaml backup
stderr '^flags go after a command: --config$'

# -h lists the commands, and after a command, its flags. Both exit 0.
exits 0 gge -h
stderr '^  validate '
exits 0 gge backup -h
stderr '^  --config string$'
! stderr '^  ..schedule'
exits 0 gge cron -h
stderr '^  --schedule string$'
stderr '^  --run-on-start$'
stderr 'GOGITEM_LOG_LEVEL'

# Each command takes only its own flags.
exits 2 gge backup --schedule '0 0 * * *'
stderr 'flag provided but not defined: -schedule'
exits 2 gge validate --parallel 2
stderr 'flag provided but not defined: -parallel'
exits 2 gge backup --no-such-flag
stderr 'flag provided but not defined: -no-such-flag'
! stdout .
