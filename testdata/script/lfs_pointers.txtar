# A repository that uses Git LFS backs up with a warning, and its snapshot
# restores the pointer file, not the content.
exec git init -q src
cp attributes src/.gitattributes
cp pointer src/model.bin
exec git -C src add .
exec git -C src commit -q -m lfs
exits 0 go-git-em -once -input src -output out
stderr 'level=WARN msg="the repository uses Git LFS: the snapshot holds only the LFS pointer files, not their content"'
stderr 'result=created'
restore out latest restored
cmp restored/model.bin pointer

-- attributes --
*.bin filter=lfs diff=lfs merge=lfs -text
-- pointer --
version https://git-lfs.github.com/spec/v1
oid sha256:4d7a214614ab2935c943f9e0ff69d22eadbb8f32b1258daaa5e2ca24d17e2393
size 12345
