# Without git on PATH, go-git-em stops at startup with a clear message and exit code 2.
env PATH=$CMDBIN
exits 2 go-git-em -once -input ./src -output ./out
stderr 'go-git-em needs git on PATH'
! stderr 'msg=backup'
! exists out

# -check needs git too.
exits 2 go-git-em -check -once -input ./src -output ./out
stderr 'go-git-em needs git on PATH'
! stdout .

# -version doesn't need git.
exits 0 go-git-em -version
stdout '^go-git-em '
