# A stop signal during a clone stops git and its HTTP helper, which are in a
# session of their own, and leaves no partial clone. They get SIGTERM, so the
# run ends well within the 5 s they would get before a SIGKILL. Each run waits
# until the helper's request reaches the server. The timeout only bounds a
# failure.
expandenv once.yaml
expandenv daemon.yaml

# With -once, the interrupted backup makes the exit code 1.
! exec go-git-em -once -config once.yaml &
waitfor servers.log 30s 'hang: GET /hang/once.git/'
sigterm
wait
stderr 'level=WARN msg=backup output='${WORK@R}'/out .* result=interrupted pruned=0 duration=([0-9.]+ms|[0-3](\.[0-9]+)?s) err=".*context canceled'
stderr 'level=ERROR msg=interrupted unfinished=1 repositories=1'
! exists out/mirror.git.tmp
! exists out/mirror.git

# A daemon stops the same way, but exits 0: being stopped is how it ends.
exec go-git-em -config daemon.yaml &
waitfor servers.log 30s 'hang: GET /hang/daemon.git/'
sigterm
wait
stderr 'level=WARN msg=backup output='${WORK@R}'/out .* result=interrupted pruned=0 duration=([0-9.]+ms|[0-3](\.[0-9]+)?s) err=".*context canceled'
stderr 'level=INFO msg=stopped$'
! exists out/mirror.git.tmp
! exists out/mirror.git

-- once.yaml --
repositories:
  - input: $GITHTTP/hang/once.git
    output: out
    timeout: 1m
-- daemon.yaml --
repositories:
  - input: $GITHTTP/hang/daemon.git
    output: out
    schedule: "@daily"
    timeout: 1m
