# Backups over ssh://, and over an scp-style URL through an ssh_config alias,
# with ssh_key.
exec git init -q work
exec git -C work commit -q --allow-empty -m one
exec git clone -q --bare work srv/repo.git
expandenv cfg.yaml
exits 0 go-git-em -once -config cfg.yaml
stderr 'level=INFO msg=backup output='${WORK@R}'/out-url input=ssh://git@127\.0\.0\.1:\d+/repo\.git result=created'
stderr 'level=INFO msg=backup output='${WORK@R}'/out-scp input=git@gitserver\.test:repo\.git result=created'
restore out-url latest restored
refs-equal srv/repo.git out-url latest
refs-equal srv/repo.git out-scp latest

# The next run fetches into the mirrors, and follows a new default branch.
exec git -C work switch -q -c trunk
exec git -C work commit -q --allow-empty -m two
exec git -C work push -q $WORK/srv/repo.git trunk
exec git -C srv/repo.git symbolic-ref HEAD refs/heads/trunk
exits 0 go-git-em -once -config cfg.yaml
stderr -count=2 'result=created'
refs-equal srv/repo.git out-url latest
refs-equal srv/repo.git out-scp latest

-- cfg.yaml --
defaults:
  ssh_key: $SSHKEY
repositories:
  - input: $GITSSH/repo.git
    output: out-url
  - input: git@gitserver.test:repo.git
    output: out-scp
