{
	"name": "Dev Container",
	"dockerFile": "./Dockerfile",
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "${containerWorkspaceFolder}/data/claude-config"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"eamodio.gitlens",
				"golang.go",
				"ms-azuretools.vscode-docker",
				"streetsidesoftware.code-spell-checker"
			]
		}
	}
}
